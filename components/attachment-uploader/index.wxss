.att-box { margin: var(--sp-2) 0; }
.att-label { font-size: 26rpx; color: var(--c-muted, #999); margin-bottom: var(--sp-1); }
.att-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.att-item { position: relative; width: 140rpx; height: 140rpx; border-radius: var(--r-sm); overflow: hidden; }
.att-img { width: 100%; height: 100%; background: var(--c-bg, #f2f2f2); }
.att-rm { position: absolute; top: -8rpx; right: -8rpx;
  width: 36rpx; height: 36rpx; line-height: 32rpx; text-align: center;
  background: rgba(0,0,0,.55); color: #fff; border-radius: 50%; font-size: 28rpx; }
.att-add { width: 140rpx; height: 140rpx; line-height: 130rpx; text-align: center;
  border: 2rpx dashed var(--c-border, #d0d5dd); border-radius: var(--r-sm); color: var(--c-muted, #999); font-size: 56rpx; }
