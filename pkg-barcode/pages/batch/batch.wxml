<!-- pkg-barcode/pages/batch/batch.wxml —— M14.2 批量操作 -->
<view class="batch page-pad">
  <view class="card">
    <view class="form-row">
      <text class="form-label">操作类型</text>
      <picker mode="selector" range="{{modes}}" range-key="label" value="{{modeIdx}}" bindchange="onMode">
        <view class="form-value">{{modes[modeIdx].label}} ›</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <text class="sec-title">添加器具（已选 {{selected.length}} 台）</text>
    <search-picker placeholder="输入名称/编号/库房/保管人搜索添加" fetch="tools" bind:pick="onPickTool" />
    <view class="sel-tip" wx:if="{{!selected.length}}"><text class="iconfont ri-arrow-right-s-line"></text> 搜索并选择要批量操作的器具，可多次添加</view>
    <!-- 已选卡片：编号 + 名称 + 库房·类别，可移除 -->
    <view wx:for="{{selected}}" wx:key="_id" class="sel-card">
      <view class="sel-info">
        <view class="sel-line1"><text class="sel-code">{{item.code}}</text><text class="sel-name">{{item.name}}</text></view>
        <text class="sel-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
      </view>
      <view class="sel-rm" data-id="{{item._id}}" bindtap="onRemove">✕</view>
    </view>
    <button class="btn btn-primary btn-block" loading="{{doing}}" bindtap="onExec">{{modes[modeIdx].label}}</button>
  </view>

  <view wx:if="{{result}}" class="card">
    <text class="sec-title">操作结果：成功 {{result.count}} 条</text>
  </view>
  <view class="safe-bottom"></view>
</view>
