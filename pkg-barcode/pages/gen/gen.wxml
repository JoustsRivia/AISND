<!-- pkg-barcode/pages/gen/gen.wxml —— M14.1 真实二维码生成与标签输出 -->
<view class="gen">
  <!-- 子功能：标识核验 / 标签打印 / 批量作业 -->
  <view class="card subnav">
    <text class="subnav-title">条码工具</text>
    <view class="subnav-row">
      <view class="subnav-item" data-url="/pkg-barcode/pages/query/query" bindtap="onGo">标识核验</view>
      <view class="subnav-item" data-url="/pkg-barcode/pages/print/print" bindtap="onGo">标签打印</view>
      <view class="subnav-item" data-url="/pkg-barcode/pages/batch/batch" bindtap="onGo">批量作业</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card loading-tip"><text class="iconfont ri-time-line"></text> 正在加载器具档案…</view>

  <view wx:else class="card">
    <!-- 三级联动筛选（2026-08-09）：先库房 → 再类别 → 最后编号，编号项带名称/库房/类别特征，同类型器具可分辨 -->
    <view class="row"><text class="label">① 库房</text>
      <picker mode="selector" range="{{stores}}" range-key="name" value="{{storeIdx}}" bindchange="onStorePick">
        <view class="picker">{{stores[storeIdx].name}} ▾</view>
      </picker>
    </view>
    <view class="row"><text class="label">② 类别</text>
      <picker mode="selector" range="{{cats}}" range-key="name" value="{{catIdx}}" bindchange="onCatPick">
        <view class="picker">{{cats[catIdx].name}} ▾</view>
      </picker>
    </view>
    <view class="row"><text class="label">③ 编号</text>
      <picker mode="selector" range="{{filtered}}" range-key="code" value="{{toolIdx}}" bindchange="onToolPick">
        <view class="picker">{{toolIdx < 0 ? '暂无器具' : filtered[toolIdx].code + ' · ' + filtered[toolIdx].name}} ▾</view>
      </picker>
    </view>
    <!-- 选中器具特征摘要：编号 + 名称 + 类别中文 + 库房，生成前可确认唯一目标 -->
    <view wx:if="{{toolIdx >= 0}}" class="tool-summary">
      <text>编号：{{filtered[toolIdx].code}}</text>
      <text>名称：{{filtered[toolIdx].name}}</text>
      <text>类别：{{filtered[toolIdx].categoryText || '—'}} · 库房：{{filtered[toolIdx].store || '—'}}</text>
    </view>
    <button class="btn-primary" bindtap="onGen">生成二维码</button>
  </view>

  <view wx:if="{{code}}" class="card qr-card">
    <view class="qr-title">器具标签（二维码 + 文字信息，保存为图片）</view>
    <view class="qr-wrap">
      <!-- 修复：单 canvas 绘制完整标签——二维码 + 编号/名称/类别/有效期/保管人文字 -->
      <canvas type="2d" id="qr" class="qr-canvas"></canvas>
    </view>
    <view class="qr-meta">
      <text>编号：{{code.code}}</text>
      <text>名称：{{code.name}}</text>
      <text>有效截止：{{code.expireAt || '—'}} · 存放：{{code.store || '—'}}</text>
      <text>保管责任人：{{code.keeperDisplay || code.keeper || '—'}}</text>
    </view>
    <button wx:if="{{rendered}}" class="btn-outline" loading="{{saving}}" bindtap="onSave">保存标签图片</button>
  </view>

  <view wx:if="{{label}}" class="card label-prev">
    <view class="title">打印标签预览</view>
    <view class="kv"><text>名称</text><text>{{label.name}}</text></view>
    <view class="kv"><text>编号</text><text>{{label.code}}</text></view>
    <view class="kv"><text>存放</text><text>{{label.store || '—'}}</text></view>
    <view class="kv"><text>保管责任人</text><text>{{label.keeperDisplay || label.keeper || '—'}}</text></view>
    <view class="kv"><text>有效期至</text><text>{{label.expireAt || '—'}}</text></view>
  </view>
</view>
