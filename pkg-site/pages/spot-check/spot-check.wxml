<!-- pkg-site/pages/spot-check/spot-check.wxml —— M6 现场点检（含今日点检概况，原 daily-check 已合并） -->
<view class="spot-check">
  <!-- 子功能：操作规程 / 班前交底 -->
  <view class="subnav">
    <view class="subnav-item" data-url="/pkg-site/pages/guide/guide" bindtap="onGo">操作规程</view>
    <view class="subnav-item" data-url="/pkg-site/pages/briefing/briefing" bindtap="onGo">班前交底</view>
  </view>

  <!-- 今日点检概况（原每日点检看板） -->
  <view class="hero">
    <view class="hero-top">
      <text class="date">{{date || '今日'}}</text>
      <text class="badge">现场点检</text>
    </view>
    <view class="progress">
      <text class="p-num">{{done}}/{{total}}</text>
      <text class="p-lbl">已完成 · 达标 {{rate}}%</text>
    </view>
    <view class="bar"><view class="bar-in" style="width:{{rate}}%;"></view></view>
    <text class="h-sub">点待检行自动带入表单，逐项确认器具状态</text>
  </view>

  <view class="section-head"><text class="section-title">点检明细</text></view>
  <view class="card">
    <view wx:if="{{loading}}" class="loading">加载中…</view>
    <view wx:elif="{{!summary.length}}" class="empty">
      <view class="empty-icon">🗒️</view>
      <view class="empty-title">今日暂无以点检器具</view>
      <view class="empty-desc">可直接在下方表单提交点检</view>
    </view>
    <view wx:for="{{summary}}" wx:key="toolId" class="row" data-item="{{item}}" bindtap="onTapItem">
      <view class="status {{item.status}}"></view>
      <view class="body">
        <text class="name">{{item.name}}</text>
        <text class="code">{{item.code}} · {{item.categoryText}}</text>
      </view>
      <text class="state-text {{item.status}}">{{item.status === 'normal' ? '正常' : item.status === 'abnormal' ? '异常' : '待检'}}</text>
      <text wx:if="{{item.status === 'pending'}}" class="go">›</text>
    </view>
  </view>

  <view class="btn grad-primary block" bindtap="goCheck">＋ 新增点检</view>

  <!-- 点检表单 -->
  <view id="check-form">
    <view class="card">
      <view class="row">
        <text class="label">器具编号</text>
        <code-autocomplete value="{{toolId}}" placeholder="选填，支持部分编号联想" bind:pick="onPickCode" />
      </view>
    </view>

    <view class="card">
      <text class="label blk">点检项（合格 / 异常）</text>
      <view wx:if="{{items.length === 0}}" class="empty">
        <view class="empty-icon">📝</view>
        <view class="empty-title">暂无点检任务</view>
      </view>
      <view wx:for="{{items}}" wx:key="text" class="check-row">
        <text class="ctext {{item.result === '合格' ? 'ok' : 'bad'}}">{{item.text}}</text>
        <switch checked="{{item.result === '合格'}}" color="#1A56DB" data-index="{{index}}" bindchange="onToggle" />
      </view>
    </view>

    <view class="card">
      <view class="row">
        <text class="label">是否异常</text>
        <switch checked="{{abnormal}}" color="#DC2626" bindchange="onAbnormal" />
      </view>
      <view class="row col">
        <text class="label blk">现场备注</text>
        <textarea class="area" placeholder="异常说明 / 现场备注" value="{{remark}}" bindinput="bindRemark" />
      </view>
    </view>

    <view class="btn grad-primary block {{submitting ? 'dis' : ''}}" bindtap="onSubmit">{{submitting ? '提交中…' : '提交点检'}}</view>
  </view>
  <view class="safe-bottom"></view>
</view>
